config BR2_PACKAGE_TRAINING_MANDATORY
	bool "Minimum setting to have something running"
	select BR2_PACKAGE_XZ
	select BR2_PACKAGE_KMOD
	select BR2_PACKAGE_KMOD_TOOLS
	select BR2_PACKAGE_HOST_KMOD_XZ
	select BR2_PACKAGE_DROPBEAR
	select BR2_TOOLCHAIN_BUILDROOT_CXX
	help
	  Install some tools:
	   - xz, kmod for kernel modules loading
	   - dropbear for ssh
	  SDK:
	   - add C++ support

config BR2_PACKAGE_TRAINING_WIFI
	bool "package for Wifi and Hotspot"
	select BR2_PACKAGE_WPA_SUPPLICANT
	select BR2_PACKAGE_HOSTAPD
	select BR2_PACKAGE_DNSMASQ
	select BR2_PACKAGE_IPTABLES
	help
	  Install:
	   - wpa_supplication
	   - hostapd
	   - dnsmasq
	   - iptables
