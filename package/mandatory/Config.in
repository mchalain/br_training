config BR2_PACKAGE_TRAINING_MANDATORY
	bool "Minimum setting to have something running"
	select BR2_PACKAGE_XZ
	select BR2_PACKAGE_KMOD
	select BR2_PACKAGE_KMOD_TOOLS
	select BR2_PACKAGE_HOST_KMOD_XZ
	select BR2_PACKAGE_DROPBEAR
	select BR2_TOOLCHAIN_BUILDROOT_CXX
	help
	  Install some tools:
	   - xz, kmod for kernel modules loading
	   - dropbear for ssh
	  SDK:
	   - add C++ support

config BR2_PACKAGE_TRAINING_WIFI
	bool "package for Wifi and Hotspot"
	select BR2_PACKAGE_WPA_SUPPLICANT
	select BR2_PACKAGE_HOSTAPD
	select BR2_PACKAGE_DNSMASQ
	select BR2_PACKAGE_IPTABLES
	help
	  Install:
	   - wpa_supplication
	   - hostapd
	   - dnsmasq
	   - iptables

config BR2_PACKAGE_TRAINING_GPU
	bool "package for GPU development"
	select BR2_PACKAGE_SPIRV_TOOLS
	select BR2_PACKAGE_MESA3D
	select BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4 if BR2_LINUX_KERNEL_DEFCONFIG="bcm2709"
	select BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D if BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
	select BR2_PACKAGE_MESA3D_VULKAN_DRIVER_BROADCOM
	select BR2_PACKAGE_MESA3D_OPENGL_ES
	select BR2_PACKAGE_MESA3D_PATENTED_VIDEO_CODECS
	select BR2_PACKAGE_VULKAN_TOOLS

